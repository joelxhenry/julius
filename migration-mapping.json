      "action": "Log missing SKUs and create placeholder parts"
    },
    {
      "rule": "Invoice totals must match sum of invoice items",
      "action": "Flag discrepancies for review"
    },
    {
      "rule": "Payment amounts cannot exceed invoice totals",
      "action": "Flag for manual review"
    },
    {
      "rule": "Historical tables (H_*) must not duplicate current data",
      "action": "Check for duplicate INV_NUMBER, QUOTE_NUM, CR_NUMBER across current and historical tables"
    },
    {
      "rule": "Historical SKUs in H_INVENT not in INVENTRY should be marked inactive",
      "action": "Set active=0 for parts only found in historical inventory"
    },
    {
      "rule": "Historical data dates should be older than current data",
      "action": "Flag for review if historical records have recent dates"
    }
