{
  "name": "turbo-julius",
  "productName": "turbo-julius",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "if exist dev.db del dev.db && drizzle-kit generate && drizzle-kit migrate",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "migrate:dbf": "tsx src/main/database/migration/cli.ts migrate",
    "migrate:dbf:dry-run": "tsx src/main/database/migration/cli.ts migrate --dry-run",
    "migrate:dbf:analyze": "tsx src/main/database/migration/cli.ts analyze"
  },
  "keywords": [],
  "author": {
    "name": "Joel Henry",
    "email": "joel.henry@islandroutes.com"
  },
  "license": "MIT",
